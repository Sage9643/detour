# Copy to backend/.env (never commit .env). All settings are read from the environment.

# SQLAlchemy URL using the psycopg (v3) driver.
# Matches docker-compose.yml defaults for local development only.
DATABASE_URL=postgresql+psycopg://detour:detour@localhost:5432/detour

# development | test | production
DETOUR_ENV=development

# DEBUG | INFO | WARNING | ERROR
DETOUR_LOG_LEVEL=INFO

# Used only by the test suite. Must point at a DISPOSABLE database:
# tests drop and recreate the schema.
TEST_DATABASE_URL=postgresql+psycopg://detour:detour@localhost:5432/detour_test
